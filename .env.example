# ═══════════════════════════════════════════════════════════════════════════
# Kigyo — plantilla de configuración
#
# Copia este archivo a `.env.local` y rellénalo. `.env.local` está ignorado
# por git; este archivo NO, para que un clon nuevo tenga la plantilla.
#
# NUNCA pongas valores reales aquí. Guía completa en docs/SETUP.md.
#
# Deja en blanco lo que no uses: una variable vacía cuenta como "sin definir",
# no como "definida con cadena vacía".
# ═══════════════════════════════════════════════════════════════════════════


# ─── Aplicación ────────────────────────────────────────────────────────────
# OBLIGATORIO. Origen público. En local, déjalo como está.
# En producción debe coincidir con la Site URL configurada en Supabase Auth,
# porque de aquí sale la URL de redirección de los correos de confirmación.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE — base de datos y autenticación
#
# Panel de Supabase → Project Settings → API
# ═══════════════════════════════════════════════════════════════════════════

# OBLIGATORIO. "Project URL". Formato: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# OBLIGATORIO. Clave "anon" / "publishable".
# Es pública por diseño: viaja al navegador. No concede acceso por sí sola —
# la migración 08 le retira todos los permisos sobre el esquema `public`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OBLIGATORIO. Clave "service_role" / "secret".
#
# ⚠ SALTA TODAS LAS POLÍTICAS RLS. Quien la tenga lee y escribe los datos de
#   todas las organizaciones. Nunca la pongas con prefijo NEXT_PUBLIC_, nunca
#   la pegues en un chat, un ticket o una captura, y rótala si se expone.
#   Solo la usa src/lib/supabase/admin.ts, protegido con `server-only`.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión directa a Postgres, solo para aplicar migraciones
# (`npm run db:push`). La app NO la usa en tiempo de ejecución.
#
# Supabase → Project Settings → Database → Connection string → URI.
# Sustituye [YOUR-PASSWORD] por la contraseña de la BASE DE DATOS, que NO es
# la service-role key. Si no la recuerdas, en esa pantalla puedes generar otra.
SUPABASE_DB_URL=


# ─── Cuenta de demostración ────────────────────────────────────────────────
# OPCIONAL. La cuenta compartida que se entrega a quien solicita una demo
# desde /contact. Es la misma que siembra `npm run db:seed`:
#
#   npm run db:seed        # crea la organización con datos de ejemplo
#
# Sin estas dos variables el formulario sigue registrando la solicitud en
# `demo_requests`, pero responde "te contactaremos" en lugar de mostrar
# credenciales que no funcionarían.
#
# ⚠ Cualquiera que envíe el formulario recibe estas credenciales: trátalas como
#   públicas. Nunca apuntes esta cuenta a una organización con datos reales, y
#   rota la contraseña re-ejecutando `npm run db:seed` (el script la actualiza
#   si la cuenta ya existe).
DEMO_ACCOUNT_EMAIL=demo@kigyo.test
DEMO_ACCOUNT_PASSWORD=


# ═══════════════════════════════════════════════════════════════════════════
# MICROSOFT FOUNDRY — MODELOS
#
# Es lo único que necesita el asistente para funcionar. Sin esta sección la
# app funciona completa, salvo la IA, que responde "no configurado" en lugar
# de fallar.
# ═══════════════════════════════════════════════════════════════════════════

# Endpoint compatible con OpenAI que expone tu recurso de Foundry.
# Portal de Azure → tu recurso → Keys and Endpoint, o Foundry → Deployments.
#
# Ambas formas funcionan:
#   https://<recurso>.openai.azure.com/openai/v1
#   https://<recurso>.services.ai.azure.com/openai/v1
AZURE_FOUNDRY_ENDPOINT=

# Nombre del DEPLOYMENT, no del modelo. Foundry → Deployments.
# A menudo coinciden, pero no siempre.
AZURE_FOUNDRY_DEPLOYMENT=

# Déjalo en blanco para usar Microsoft Entra (ver más abajo).
# Portal de Azure → tu recurso → Keys and Endpoint → KEY 1.
AZURE_FOUNDRY_API_KEY=

# OPCIONAL — solo para diagnóstico (`npm run check:foundry`). La app NO lo usa.
# Foundry → Overview → "Punto de conexión del proyecto".
# Sirve para responder "¿puedo habilitar Foundry IQ aquí?": si el proyecto no
# tiene conectado un Azure AI Search, no.
AZURE_FOUNDRY_PROJECT_ENDPOINT=


# ═══════════════════════════════════════════════════════════════════════════
# FOUNDRY IQ — OPCIONAL
#
# Es un recurso DISTINTO de los modelos: una knowledge base servida por Azure
# AI Search, que hay que crear e indexar aparte. Tener modelos sin knowledge
# base es una configuración normal.
#
# Sin esta sección el asistente sigue funcionando: responde consultando la
# base de datos en vivo, que es de donde salen las respuestas operativas. Lo
# que se pierde es el anclaje en documentos subidos, y las respuestas no
# llevan citas.
# ═══════════════════════════════════════════════════════════════════════════

# Endpoint del servicio de Azure AI Search.
# Formato: https://<nombre-del-servicio>.search.windows.net
AZURE_SEARCH_ENDPOINT=

# Nombre de la knowledge base.
# Microsoft Foundry (ai.azure.com) → Build → Knowledge.
FOUNDRY_IQ_KNOWLEDGE_BASE=

# Nombre del knowledge source dentro de esa knowledge base.
#
# ⚠ REQUISITO CRÍTICO si la usas con más de una organización: el índice de este
#   knowledge source debe tener un campo `org_id` marcado como FILTRABLE. Cada
#   consulta envía `filterAddOn: org_id eq '<organización>'`. Si el campo no
#   existe o no es filtrable, Azure AI Search ignora el filtro EN SILENCIO y el
#   asistente devolverá documentos de todas las organizaciones. No hay error ni
#   aviso.
#
#   Compruébalo antes de usarla:  npm run check:foundry
FOUNDRY_IQ_KNOWLEDGE_SOURCE=

# Déjalo en blanco para usar Entra.
# Portal de Azure → servicio de búsqueda → Keys → Admin key.
AZURE_SEARCH_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# MICROSOFT ENTRA — OPCIONAL
#
# Solo si dejaste las claves de API en blanco. Se prefiere sobre las claves
# porque una clave no se puede acotar por permiso, no rota sin desplegar y no
# se puede atribuir a nadie en los registros.
#
#   · Desplegado en Azure: asigna una identidad administrada a la app con los
#     roles `Cognitive Services OpenAI User` sobre el recurso de Foundry y
#     `Search Index Data Reader` sobre el de búsqueda. Deja las tres en blanco.
#
#   · En local: ejecuta `az login` y déjalas en blanco, o rellénalas con una
#     app registration (Entra ID → App registrations).
# ═══════════════════════════════════════════════════════════════════════════

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
# FACTURACIÓN — OPCIONAL
#
# El secreto con el que /api/billing/webhook verifica la firma de cada evento
# del proveedor de pagos. Sin él la ruta responde 503 y no acepta nada: un
# endpoint que puede suspender las empresas de un cliente no debe funcionar
# sin forma de distinguir quién lo llama.
#
# Todavía no hay proveedor elegido. Hasta que lo haya, el adaptador `manual`
# (src/lib/billing/provider.ts) verifica un HMAC-SHA256 del cuerpo crudo con
# este valor — la misma comprobación que hace cualquier procesador — así que
# el andamiaje se puede probar de punta a punta:
#
#   BODY='{"event_id":"evt_1","kind":"subscription.updated",
#          "account_id":"<uuid>","plan":"growth","status":"active"}'
#   FIRMA=$(printf '%s' "$BODY" | openssl dgst -sha256 -hmac "$BILLING_WEBHOOK_SECRET" -hex | cut -d' ' -f2)
#   curl -X POST localhost:3000/api/billing/webhook \
#        -H "x-kigyo-signature: $FIRMA" -d "$BODY"
#
# Mínimo 16 caracteres. Genera uno con: openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════════════

BILLING_WEBHOOK_SECRET=

# Secreto de eventos de Wompi: firma los webhooks de pago del POS (QR).
# Sin él, /api/wompi/webhook responde 503 y ningún pago se confirma.
WOMPI_EVENTS_SECRET=
