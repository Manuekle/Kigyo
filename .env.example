# ═══════════════════════════════════════════════════════════════════════════
# Kigyo — plantilla de configuración
#
# Copia este archivo a `.env.local` y rellénalo. `.env.local` está ignorado
# por git; este archivo NO, para que un clon nuevo tenga la plantilla.
#
# NUNCA pongas valores reales aquí. Guía completa en docs/SETUP.md.
#
# Deja en blanco lo que no uses: una variable vacía cuenta como "sin definir",
# no como "definida con cadena vacía".
# ═══════════════════════════════════════════════════════════════════════════


# ─── Aplicación ────────────────────────────────────────────────────────────
# OBLIGATORIO. Origen público. En local, déjalo como está.
# En producción debe coincidir con la Site URL configurada en Supabase Auth,
# porque de aquí sale la URL de redirección de los correos de confirmación.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE — base de datos y autenticación
#
# Panel de Supabase → Project Settings → API
# ═══════════════════════════════════════════════════════════════════════════

# OBLIGATORIO. "Project URL". Formato: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# OBLIGATORIO. Clave "anon" / "publishable".
# Es pública por diseño: viaja al navegador. No concede acceso por sí sola —
# la migración 08 le retira todos los permisos sobre el esquema `public`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OBLIGATORIO. Clave "service_role" / "secret".
#
# ⚠ SALTA TODAS LAS POLÍTICAS RLS. Quien la tenga lee y escribe los datos de
#   todas las organizaciones. Nunca la pongas con prefijo NEXT_PUBLIC_, nunca
#   la pegues en un chat, un ticket o una captura, y rótala si se expone.
#   Solo la usa src/lib/supabase/admin.ts, protegido con `server-only`.
SUPABASE_SERVICE_ROLE_KEY=


# ═══════════════════════════════════════════════════════════════════════════
# MICROSOFT FOUNDRY IQ — recuperación de contexto (Azure AI Search)
#
# Sin esta sección la app funciona completa, salvo el asistente de IA, que
# responde "no configurado" en lugar de fallar.
# ═══════════════════════════════════════════════════════════════════════════

# Endpoint del servicio de Azure AI Search que respalda tu proyecto Foundry.
# Portal de Azure → tu servicio de búsqueda → Overview → Url.
# Formato: https://<nombre-del-servicio>.search.windows.net
AZURE_SEARCH_ENDPOINT=

# Nombre de la knowledge base.
# Microsoft Foundry (ai.azure.com) → Build → Knowledge.
FOUNDRY_IQ_KNOWLEDGE_BASE=

# Nombre del knowledge source dentro de esa knowledge base.
#
# ⚠ REQUISITO CRÍTICO: el índice de este knowledge source debe tener un campo
#   `org_id` marcado como FILTRABLE. Cada consulta envía
#   `filterAddOn: org_id eq '<organización>'`. Si el campo no existe o no es
#   filtrable, Azure AI Search ignora el filtro EN SILENCIO y el asistente
#   devolverá documentos de todas las organizaciones. No hay error ni aviso.
#
#   Compruébalo antes de usarlo con más de un cliente:  npm run check:foundry
FOUNDRY_IQ_KNOWLEDGE_SOURCE=


# ═══════════════════════════════════════════════════════════════════════════
# AZURE OPENAI — redacción de la respuesta
#
# Hacen falta los dos servicios. La API estable de recuperación (2026-04-01)
# eliminó la síntesis de respuesta: devuelve fragmentos con citas, y el modelo
# de abajo es el que redacta.
# ═══════════════════════════════════════════════════════════════════════════

# Portal de Azure → tu recurso de Azure OpenAI → Keys and Endpoint.
# Formato: https://<nombre-del-recurso>.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Nombre del DEPLOYMENT, no del modelo. Foundry → Deployments.
# A menudo coinciden, pero no siempre.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Versión de la API de Azure OpenAI. Cámbiala solo si sabes por qué.
AZURE_OPENAI_API_VERSION=2024-10-21


# ═══════════════════════════════════════════════════════════════════════════
# AUTENTICACIÓN CON AZURE — elige UNA de las dos opciones
# ═══════════════════════════════════════════════════════════════════════════

# ─── Opción A (recomendada): Microsoft Entra ───────────────────────────────
#
# Deja AZURE_SEARCH_API_KEY y AZURE_OPENAI_API_KEY EN BLANCO y el código usa
# Entra automáticamente. Se prefiere sobre las claves porque una clave no se
# puede acotar por permiso, no rota sin desplegar y no se puede atribuir a
# nadie en los registros.
#
#   · Desplegado en Azure: asigna una identidad administrada a la app con los
#     roles `Search Index Data Reader` sobre el servicio de búsqueda y
#     `Cognitive Services OpenAI User` sobre el recurso de OpenAI. Deja las
#     tres variables de abajo también en blanco.
#
#   · En local: ejecuta `az login` y deja las tres en blanco, o rellénalas con
#     una app registration (Entra ID → App registrations).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ─── Opción B: claves de API ───────────────────────────────────────────────
#
# Más rápido para empezar en local. No es la configuración recomendada para
# producción. Si rellenas estas, las de Entra se ignoran.
#
# Búsqueda: portal de Azure → servicio de búsqueda → Keys → Admin key.
AZURE_SEARCH_API_KEY=

# OpenAI: portal de Azure → recurso de OpenAI → Keys and Endpoint → KEY 1.
AZURE_OPENAI_API_KEY=
